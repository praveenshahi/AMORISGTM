---
export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  schema?: string;
}
const {
  title,
  description = "Amoris designs and deploys agentic AI systems for B2B go-to-market teams — LangGraph orchestration, Clay enrichment, n8n automation. Built by Praveen Shahi, AI GTM Engineer.",
  ogTitle,
  schema,
} = Astro.props;

const SITE = 'https://amoris.in';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const parts = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = [
  { name: 'Home', item: `${SITE}/` },
  ...parts.map((part: string, i: number) => ({
    name: part.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    item: `${SITE}/` + parts.slice(0, i + 1).join('/') + '/',
  })),
];

/* ── Entity graph ──────────────────────────────────────────────
   Person + Organization + WebSite emitted as one @graph with @id
   cross-references, so search and answer engines resolve "Praveen
   Shahi" and "Amoris" as linked entities rather than loose strings.
   `sameAs` is what ties this site to the existing profiles.        */
const entityGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/founder#person`,
      "name": "Praveen Shahi",
      "givenName": "Praveen",
      "familyName": "Shahi",
      "jobTitle": "AI GTM Engineer",
      "description": "Praveen Shahi is an AI GTM Engineer who designs and deploys agentic automation for B2B revenue teams. Ten years running revenue organisations, now building the AI systems that make revenue scale.",
      "url": `${SITE}/founder`,
      "email": "mailto:shahi@amoris.in",
      "telephone": "+91-9100-933-191",
      "address": { "@type": "PostalAddress", "addressLocality": "Bengaluru", "addressCountry": "IN" },
      "knowsAbout": [
        "AI GTM Engineering",
        "Agentic automation",
        "LangGraph",
        "Clay",
        "n8n",
        "RAG pipelines",
        "Go-to-market strategy",
        "Sales operations",
        "Voice AI agents",
        "LLM observability"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/praveenshahi13",
        "https://github.com/praveenshahi",
        "https://www.npmjs.com/package/intel-echo"
      ],
      "worksFor": { "@id": `${SITE}/#organization` }
    },
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      "name": "Amoris",
      "url": SITE,
      "description": "Amoris is an AI GTM agency that designs and deploys agentic automation for B2B revenue teams — audit, design, deploy. Systems are self-hosted and customer-owned.",
      "founder": { "@id": `${SITE}/founder#person` },
      "areaServed": ["IN", "US", "GB", "SG", "AE"],
      "address": { "@type": "PostalAddress", "addressLocality": "Bengaluru", "addressCountry": "IN" },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales",
          "email": "shahi@amoris.in",
          "availableLanguage": ["English", "Hindi"],
          "url": `${SITE}/#contact`
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "name": "Amoris",
      "url": SITE,
      "description": "AI GTM systems for B2B revenue teams — agentic automation, built and deployed end to end.",
      "publisher": { "@id": `${SITE}/#organization` }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Flags JS as available before first paint, so the scroll-reveal start
       state only applies when there is JS to finish the animation. -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Amoris" />
  <meta property="og:image" content={`${SITE}/og/og-default.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0A0A0B" />

  <!-- Fonts — non-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" /></noscript>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/styles/tokens.css" />

  <!-- Google Analytics 4 — is:inline keeps gtag on window; without it
       Astro hoists this into a module and gtag stops being global. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6FCMQYGWP2"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6FCMQYGWP2');
  </script>

  <!-- Microsoft Clarity -->
  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window,document,"clarity","script","xizt3yamet");
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />

  {schema && <Fragment set:html={`<script type="application/ld+json">${schema}</script>`} />}

  {parts.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": b.name,
        "item": b.item,
      })),
    })} />
  )}
</head>
<body>
