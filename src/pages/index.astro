---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';
import LogoTicker from '../components/LogoTicker.astro';

const title = "AI GTM Systems That Actually Scale | Amoris — Agentic Automation for B2B Revenue Teams";
const description = "Amoris designs and deploys agentic AI systems for B2B go-to-market teams. From audit to orchestration to live systems. LangGraph, Clay enrichment, n8n automation. Self-hosted, customer-owned.";

const cases = [
  {
    headline: "Scaling outbound with zero new headcount",
    problem: "B2B SaaS with 3 SDRs, no qualification process. Lost 40% of leads in first call due to misfit profile.",
    solution: "Built LangGraph voice agent + Clay enrichment layer. Automated lead qualification, call logging, and CRM sync.",
    result: "Qualified 60% more leads. SDR time shifted from qualification → strategy. No new hires. Same budget.",
    metric: "60% qualified",
  },
  {
    headline: "Turning raw lists into qualified opportunities",
    problem: "Importing lists was manual and error-prone. No waterfall enrichment. High bounce rate on cold outreach.",
    solution: "Multi-step enrichment via Clay (company size, tech stack, recent funding). Linked to n8n webhook for CRM scoring.",
    result: "90% data accuracy. 3.5x cold email reply rate. List quality became competitive advantage.",
    metric: "3.5x reply rate",
  },
  {
    headline: "Building the automation layer",
    problem: "Growing startup with no GTM infrastructure. Using 12 disconnected tools. No data flow.",
    solution: "Designed end-to-end orchestration system. LangGraph for multi-step qualification. n8n for webhook routing. PostgreSQL for conversation memory.",
    result: "Single source of truth. 10x faster qualification. Self-hosted, customer-owned.",
    metric: "10x faster",
  },
];

const phases = [
  {
    n: "Audit",
    body: "We map your entire GTM workflow—how leads flow in, where they stall, where humans are doing repetitive work. No assumptions. We see what's actually broken.",
  },
  {
    n: "Design",
    body: "We design an orchestrated system using LangGraph for reasoning, Clay for waterfall enrichment, and n8n for webhook orchestration. Every decision is traceable to your specific workflow. You own the architecture.",
  },
  {
    n: "Deploy",
    body: "We self-host on your infrastructure. The system runs 24/7. We measure, optimize, and iterate based on production data. Not a one-off project—a living system.",
  },
];

const faqs = [
  {
    q: "How is this different from Zapier or Make?",
    a: "Zapier and Make are no-code connectors between off-the-shelf tools. Amoris builds custom reasoning systems — LangGraph agents that qualify leads, Clay enrichment layers, n8n workflows that don't exist yet. We're not connecting tools; we're building your GTM infrastructure from first principles.",
  },
  {
    q: "Do we own the systems Amoris builds?",
    a: "Yes. Systems are deployed on your own infrastructure and you own them outright — the workflows, the prompts, the database, the code. There is no platform lock-in and no dependency on Amoris to keep them running.",
  },
  {
    q: "What does the audit actually cover?",
    a: "We map your entire GTM workflow end-to-end: how leads flow in, where qualification happens (or doesn't), where humans are doing repetitive work, and where your current tools are creating bottlenecks. We deliver a written map of problems and opportunities. You get value from the audit whether or not you hire us for implementation.",
  },
  {
    q: "What's the typical timeline?",
    a: "Audit is 1-2 hours. Design is 1-2 weeks (depends on complexity). Deploy is 2-4 weeks. But we iterate continuously after launch, so the engagement doesn't end—the system keeps improving based on production data.",
  },
];
---
<Base title={title} description={description}>

<!-- HERO -->
<section class="hm-hero glow-section">
  <p class="section-eyebrow reveal">Amoris — AI GTM Agency</p>
  <h1 class="reveal reveal-d1">AI GTM Systems<br/>That <span class="gradient-text">Actually Scale</span></h1>
  <p class="hm-lede reveal reveal-d2">
    Most SMBs automate parts of GTM. We automate the entire motion—from lead enrichment
    to qualification to CRM handoff. One orchestrated system. No tool sprawl.
  </p>
  <div class="hm-cta reveal reveal-d3">
    <a href="#cases" class="btn btn-primary">See how it works →</a>
    <a href="https://calendly.com/praveenshahi13/30min" class="btn btn-outline" target="_blank" rel="noopener">Schedule a 20-min audit</a>
  </div>
  <ul class="hm-stack reveal reveal-d4" aria-label="Core technologies">
    <li class="tag tag-gold">LangGraph</li>
    <li class="tag">Clay</li>
    <li class="tag">n8n</li>
    <li class="tag">PostgreSQL</li>
    <li class="tag">Retell / ElevenLabs</li>
  </ul>
</section>

<!-- EXPERIENCE LOGOS -->
<LogoTicker />

<!-- METHODOLOGY -->
<section id="how">
  <p class="section-eyebrow reveal">How we build your GTM automation stack</p>
  <h2 class="reveal">Audit <span class="hm-arrow">→</span> Design <span class="hm-arrow">→</span> Deploy</h2>
  <p class="hm-section-lede reveal">
    Three phases. Three outcomes. One system you own.
  </p>

  <div class="grid-3 hm-phases">
    {phases.map((p, i) => (
      <article class={`card card-gold reveal reveal-d${i + 1}`}>
        <div class="card-label">{p.n}</div>
        <p class="hm-phase-body">{p.body}</p>
      </article>
    ))}
  </div>
</section>

<!-- CASES -->
<section id="cases">
  <p class="section-eyebrow reveal">Results in production</p>
  <h2 class="reveal">Real systems. Real results.</h2>
  <div class="grid-3 hm-cases">
    {cases.map((c, i) => (
      <div class={`card reveal reveal-d${i + 1}`}>
        <h3 class="hm-case-headline">{c.headline}</h3>
        <div class="hm-case-block">
          <p class="hm-case-label">Problem:</p>
          <p class="hm-case-text">{c.problem}</p>
        </div>
        <div class="hm-case-block">
          <p class="hm-case-label">Solution:</p>
          <p class="hm-case-text">{c.solution}</p>
        </div>
        <div class="hm-case-block">
          <p class="hm-case-label">Result:</p>
          <p class="hm-case-text">{c.result}</p>
        </div>
        <div class="hm-case-metric">
          <span class="tag tag-gold">{c.metric}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- STACK -->
<section id="stack">
  <p class="section-eyebrow reveal">Built on production-grade architecture</p>
  <h2 class="reveal">The stack that scales.</h2>
  <div class="grid-3 hm-stack-cards">
    <div class="card reveal">
      <h3 class="hm-stack-headline">LangGraph</h3>
      <p>Multi-step reasoning chains for qualification logic. Not one-shot API calls. Agents that reason, adapt, and refine.</p>
    </div>
    <div class="card reveal reveal-d1">
      <h3 class="hm-stack-headline">Clay + LLM Waterfall</h3>
      <p>Deterministic enrichment (Clay first). Then LLM for intent signals and personalization. Highest accuracy, lowest cost.</p>
    </div>
    <div class="card reveal reveal-d2">
      <h3 class="hm-stack-headline">n8n Automation</h3>
      <p>Real-time triggers. Event-driven workflows. Connects your entire GTM stack without custom code.</p>
    </div>
  </div>
  <p class="hm-stack-supporting reveal">PostgreSQL for state management. Retell for voice AI. All self-hosted, fully owned by you.</p>
</section>

<!-- ICP -->
<section id="icp">
  <p class="section-eyebrow reveal">Built for growing B2B SaaS</p>
  <p class="hm-icp-text reveal">
    If you're a Series A/B SaaS with 5–50 person teams, outbound motion that's not scaling,
    and no dedicated GTM infrastructure — we're a fit. If you're an enterprise or pre-product,
    we're probably not.
  </p>
  <p class="hm-icp-supporting reveal">
    We're not a no-code tool. We're a systems partner. This requires ownership and iteration from your side.
  </p>
</section>

<!-- CTA -->
<section id="cta">
  <p class="section-eyebrow reveal">Ready to automate your GTM motion?</p>
  <div class="hm-cta-buttons reveal">
    <a href="https://calendly.com/praveenshahi13/30min" class="btn btn-primary" target="_blank" rel="noopener">Schedule a 20-min audit</a>
    <a href="#cases" class="btn btn-outline">Explore case studies</a>
    <a href="mailto:shahi@amoris.in" class="btn btn-outline">Email us</a>
  </div>
</section>

<!-- FLAGSHIP PRODUCT -->
<section id="amoris-ai-sdr">
  <p class="section-eyebrow reveal">Flagship product</p>
  <h2 class="reveal">Amoris AI SDR</h2>
  <p class="hm-section-lede reveal">
    Research-to-email intelligence. Built for Bangalore B2B agencies running outbound.
  </p>

  <div class="grid-2 hm-sdr-body">
    <div class="reveal">
      <h3 class="hm-sdr-subheading">What it does</h3>
      <p>
        Give it a company name. It researches live, analyzes GTM fit, forms a commercial hypothesis, writes an evidence-disciplined outbound email, and judges its own output. All in 38 seconds. Then you decide: send or skip.
      </p>
      <div class="hm-sdr-flow">
        <p class="hm-flow-step"><strong>1. Research</strong> — Live web research per company. Structured GTM analysis with evidence URLs, not guesses.</p>
        <p class="hm-flow-step"><strong>2. Reason</strong> — Forms a testable hypothesis. Matches it to real experience. Writes the email.</p>
        <p class="hm-flow-step"><strong>3. Judge</strong> — Independently evaluates the output against 14 quality criteria. Ready to send or HOLD with a reason.</p>
      </div>
    </div>

    <div class="reveal reveal-d1">
      <div class="card card-gold">
        <h3 class="hm-sdr-card-title">Why it's different</h3>
        <ul class="hm-sdr-features">
          <li><strong>Evidence discipline:</strong> Every claim traces to a cited source. Hypotheses are curiosity, not diagnosis.</li>
          <li><strong>HOLD is a feature:</strong> Most AI sales tools always send. This one knows when not to.</li>
          <li><strong>Signal-first:</strong> Email changes per company in argument, not just name.</li>
          <li><strong>Human in the loop:</strong> AI researches and drafts. You send. Judgment stays with you.</li>
        </ul>
        <div class="hm-sdr-cta">
          <a href="https://wa.me/919100933191?text=Tell%20me%20about%20Amoris%20AI%20SDR" class="btn btn-primary" target="_blank" rel="noopener">Ask about Amoris AI SDR →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq">
  <p class="section-eyebrow reveal">Common questions</p>
  <h2 class="reveal">What people ask before the first call</h2>
  <div class="hm-faq reveal">
    <FAQ items={faqs} />
  </div>
</section>

</Base>

<style>
  /* Namespaced hm-* so nothing collides with tokens.css */
  .hm-hero { padding-top: 96px; padding-bottom: 72px; }
  .hm-hero h1 { margin-bottom: 24px; }
  .hm-lede {
    font-size: 1.15rem;
    max-width: 60ch;
    margin-bottom: 36px;
  }
  .hm-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 44px; }
  .hm-stack { display: flex; gap: 8px; flex-wrap: wrap; list-style: none; }


  .hm-section-lede { max-width: 62ch; margin: 20px 0 48px; font-size: 1.02rem; }

  /* Timeline — a real chronology, so the rail and dates carry meaning */
  .hm-beats { list-style: none; position: relative; padding-left: 28px; }
  .hm-beats::before {
    content: '';
    position: absolute;
    left: 5px; top: 6px; bottom: 6px;
    width: 1px;
    background: linear-gradient(180deg, var(--gold), rgba(240,168,36,0.12));
  }
  .hm-beat { position: relative; padding-bottom: 36px; }
  .hm-beat:last-child { padding-bottom: 0; }
  .hm-beat::before {
    content: '';
    position: absolute;
    left: -28px; top: 7px;
    width: 11px; height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--gold);
  }
  .hm-beat-when { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 8px; }
  .hm-beat-years {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--gold);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .hm-beat-role {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }
  .hm-beat-body { max-width: 66ch; margin: 0; }

  .hm-arrow { color: var(--gold); font-weight: 400; }
  .hm-phases { margin-top: 8px; align-items: start; }
  .hm-phase-body { font-size: 0.95rem; margin-bottom: 18px; }
  .hm-phase-stack { display: flex; gap: 6px; flex-wrap: wrap; list-style: none; }

  .hm-results { margin-top: 40px; }
  .hm-results h3 { margin-bottom: 12px; }
  .hm-results p { font-size: 0.95rem; margin: 0; }

  .hm-cases { margin-top: 40px; }
  .hm-case-headline { margin-top: 0; margin-bottom: 16px; font-size: 1.1rem; }
  .hm-case-block { margin-bottom: 14px; }
  .hm-case-label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--gold); letter-spacing: 0.04em; margin: 0 0 4px 0; text-transform: uppercase; }
  .hm-case-text { font-size: 0.93rem; margin: 0; color: var(--text-dim); }
  .hm-case-metric { margin-top: 18px; }

  .hm-stack-cards { margin-top: 8px; }
  .hm-stack-headline { margin-top: 0; margin-bottom: 12px; font-size: 1.05rem; }
  .hm-stack-supporting { max-width: 70ch; margin: 32px 0 0 0; font-size: 0.95rem; }

  .hm-icp-text { font-size: 1.05rem; max-width: 70ch; margin: 28px 0 0 0; }
  .hm-icp-supporting { font-size: 0.95rem; color: var(--text-dim); margin: 16px 0 0 0; }

  .hm-cta-buttons { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }

  .hm-sdr-body { gap: 40px; align-items: start; margin-top: 36px; }
  .hm-sdr-subheading { margin-top: 0; margin-bottom: 16px; font-size: 1.1rem; }
  .hm-sdr-body > div:first-child p { font-size: 1rem; margin-bottom: 20px; line-height: 1.6; }
  .hm-sdr-flow { margin: 28px 0 0 0; }
  .hm-flow-step { font-size: 0.95rem; margin-bottom: 12px; line-height: 1.6; color: var(--text-dim); }
  .hm-flow-step strong { color: var(--text); }
  .hm-sdr-card-title { margin-top: 0; margin-bottom: 16px; font-size: 1.05rem; }
  .hm-sdr-features { list-style: none; margin: 0 0 20px 0; padding: 0; }
  .hm-sdr-features li { font-size: 0.93rem; margin-bottom: 14px; line-height: 1.6; }
  .hm-sdr-features strong { color: var(--gold); }
  .hm-sdr-cta { margin-top: 24px; }

  .hm-faq { margin-top: 32px; max-width: 78ch; }

  @media (max-width: 860px) {
    .hm-hero { padding-top: 72px; }
    .hm-lede { font-size: 1.05rem; }
    .hm-cta-buttons { flex-direction: column; }
    .hm-cta-buttons .btn { width: 100%; }
  }
</style>
