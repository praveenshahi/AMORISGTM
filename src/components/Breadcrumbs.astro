---
/* Visual breadcrumb trail only.
   BreadcrumbList JSON-LD is emitted once, site-wide, by Base.astro from the
   URL path — emitting it here too would put two BreadcrumbList objects on
   the same page. */
export interface Crumb { label: string; href?: string; }
export interface Props { crumbs: Crumb[]; }
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  {crumbs.map((c, i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      {c.href
        ? <a href={c.href}>{c.label}</a>
        : <span style="color:var(--text-dim)" aria-current="page">{c.label}</span>}
    </>
  ))}
</nav>
