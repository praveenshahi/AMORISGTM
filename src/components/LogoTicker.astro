---
/* Logo ticker banner: continuous scroll animation with company logos and labels */

const logos = [
  {
    company: "Amazon",
    logoUrl: "https://cdn.simpleicons.org/amazon/F0A824",
    label: "Infrastructure at scale",
    alt: "Amazon logo",
  },
  {
    company: "Meta",
    logoUrl: "https://cdn.simpleicons.org/meta/F0A824",
    label: "Growth loops & optimization",
    alt: "Meta logo",
  },
  {
    company: "Great Learning",
    logoUrl: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 60'%3E%3Ctext x='10' y='40' font-family='Space Grotesk, sans-serif' font-size='24' font-weight='700' fill='%23F0A824'%3EGL%3C/text%3E%3C/svg%3E",
    label: "Operations & team building",
    alt: "Great Learning logo",
  },
  {
    company: "Leverage Edu",
    logoUrl: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 60'%3E%3Ctext x='10' y='40' font-family='Space Grotesk, sans-serif' font-size='20' font-weight='700' fill='%23F0A824'%3ELEV%3C/text%3E%3C/svg%3E",
    label: "Revenue models & GTM",
    alt: "Leverage Edu logo",
  },
];
---

<section class="hm-logo-ticker">
  <p class="hm-ticker-eyebrow reveal">Built by experience</p>
  <h2 class="reveal">Ten years of GTM, system design, and growth.</h2>

  <div class="hm-ticker-container reveal">
    <div class="ticker-track">
      {logos.map((logo) => (
        <div class="ticker-item">
          <img src={logo.logoUrl} alt={logo.alt} class="ticker-logo" loading="lazy" />
          <p class="ticker-label">{logo.label}</p>
        </div>
      ))}
      {/* Duplicate for seamless loop */}
      {logos.map((logo) => (
        <div class="ticker-item">
          <img src={logo.logoUrl} alt={logo.alt} class="ticker-logo" loading="lazy" />
          <p class="ticker-label">{logo.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hm-logo-ticker {
    padding: 60px 48px;
  }
  .hm-logo-ticker h2 {
    margin-top: 12px;
    margin-bottom: 40px;
  }
  .hm-ticker-eyebrow {
    margin-bottom: 8px;
  }

  .hm-ticker-container {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .ticker-track {
    display: flex;
    gap: 100px;
    animation: scroll 50s linear infinite;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-width: fit-content;
    flex-shrink: 0;
  }

  .ticker-logo {
    height: 50px;
    max-width: 150px;
    object-fit: contain;
    filter: brightness(0.9);
    transition: filter 0.3s ease;
  }

  .ticker-item:hover .ticker-logo {
    filter: brightness(1);
  }

  .ticker-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
    text-align: center;
    margin: 0;
    white-space: nowrap;
    max-width: 140px;
    line-height: 1.3;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 50px));
    }
  }

  @media (max-width: 768px) {
    .hm-logo-ticker {
      padding: 40px 24px;
    }
    .hm-logo-ticker h2 {
      margin-bottom: 28px;
      font-size: clamp(1.5rem, 3vw, 1.8rem);
    }
    .ticker-track {
      gap: 60px;
    }
    .ticker-logo {
      height: 40px;
      max-width: 120px;
    }
    .ticker-label {
      font-size: 0.7rem;
      max-width: 110px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
    .ticker-item {
      gap: 8px;
    }
  }
</style>
